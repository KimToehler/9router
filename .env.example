# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# RTK tool_result compression caps (open-sse/rtk/constants.js)
# RTK compresses tool_result blocks (git/grep/find/diff) before they reach the
# model. Stock caps truncate normal-sized dev output, so agents re-fetch the same
# command narrower (wasted calls). Raise these to pass precision-critical output
# through verbatim while still compressing genuinely huge blobs. Every RTK_* below
# is optional; unset falls back to the historical default shown in the comment.
# No rebuild needed to retune (constants.js reads process.env at boot).
# MIN_COMPRESS_SIZE is the biggest lever: anything smaller is passed untouched.
# RTK_MIN_COMPRESS_SIZE=4096          # default 500;  skip compression under N bytes
# RTK_GIT_DIFF_HUNK_MAX_LINES=600     # default 100;  per-hunk line cap
# RTK_GIT_LOG_MAX_LINES=500           # default 200
# RTK_GREP_PER_FILE_MAX=40            # default 10
# RTK_STATUS_MAX_FILES=60             # default 10
# RTK_STATUS_MAX_UNTRACKED=60         # default 10
# Other tunables (defaults in parens): RTK_RAW_CAP (10485760), RTK_DETECT_WINDOW
# (1024), RTK_GIT_DIFF_CONTEXT_KEEP (3), RTK_DEDUP_LINE_MAX (2000),
# RTK_FIND_PER_DIR_MAX (10), RTK_FIND_TOTAL_DIR_MAX (20), RTK_TREE_MAX_LINES (200),
# RTK_SEARCH_LIST_PER_DIR_MAX (10), RTK_SEARCH_LIST_TOTAL_DIR_MAX (20),
# RTK_SMART_TRUNCATE_HEAD (120), RTK_SMART_TRUNCATE_TAIL (60),
# RTK_SMART_TRUNCATE_MIN_LINES (250)

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
